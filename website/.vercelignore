# Vercel builds this site itself (see vercel.json), so everything the build
# needs -- package.json, package-lock.json, tools/ -- must reach it. This
# file only keeps out what the build regenerates or must never see.
#
# node_modules is the big one: ~60 MB of pagefind binaries. The repo
# .gitignore covers it, but that lives at the repo root while the deploy
# root is website/, so a CLI deploy would never read it.

node_modules/

# Generated by `npm run build` on the deploy itself. They are gitignored
# too -- committing build output is what used to let the site drift from
# its sources.
docs/
get/

# local scratch and CLI state. .env.local holds a VERCEL_OIDC_TOKEN the CLI
# writes on link — git ignores it, and it has no business being uploaded.
.DS_Store
*.log
.env*
.vercel/
